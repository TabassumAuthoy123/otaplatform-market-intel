# ============================================================================
#  Copy this file to .env and fill in the real values.
#  .env is gitignored. Never commit real credentials — this repo is public.
# ============================================================================

# ---- MySQL (optional) ------------------------------------------------------
# Only needed if you move the dataset off the JSON files into OTAPlatform's
# MySQL. From the Windows host the published port is 3307, password is 'root'.
DATABASE_URL="mysql://root:root@127.0.0.1:3307/ota_market_intel"
# From inside a container on the shared network, use the service name and 3306:
# DATABASE_URL="mysql://root:root@otaplatform_mysql:3306/ota_market_intel"

NEXT_PUBLIC_APP_NAME="OTA Platform — Market Intelligence"


# ---- GDS: Travelport ------------------------------------------------------
# Powers flight search on /portal/flights and the PNR check on /accounts/gds.
# Leave blank and both pages still work — they show sample data and say plainly
# that the live half is not connected.
#
# READ THIS BEFORE FILLING IT IN
# The paths below are examples of the SHAPE, not verified Travelport endpoints.
# Travelport sells several APIs (the JSON APIs, and the older uAPI SOAP
# services) and the correct path depends on which products your agency is
# provisioned for. Take the real endpoint from your own Travelport API
# documentation. Nothing in this codebase guesses it for you.

# --- shared credentials (needed by both search and PNR) ---
# GDS_BASE_URL="https://api.pp.travelport.com"
# GDS_USERNAME="your-travelport-login-id"
# GDS_PASSWORD="your-travelport-password"

# --- flight search, used by /portal/flights ---
# {from} {to} {date} {adults} {cabin} are substituted in both path and body.
# GDS_SEARCH_PATH="/v1/air/search"
# GDS_SEARCH_METHOD="POST"
# GDS_SEARCH_BODY='{"origin":"{from}","destination":"{to}","departureDate":"{date}","adults":{adults},"cabin":"{cabin}"}'

# If your product wants a plain GET instead:
# GDS_SEARCH_PATH="/v1/air/search?origin={from}&destination={to}&date={date}&adults={adults}"
# GDS_SEARCH_METHOD="GET"

# --- reservation retrieval, used by /accounts/gds ---
# {locator} is substituted with the PNR.
# GDS_PNR_PATH="/v1/reservation/{locator}"
# GDS_PNR_METHOD="GET"

# --- optional for both ---
# GDS_ACCEPT="application/json"
# GDS_CONTENT_TYPE="application/json"
# GDS_EXTRA_HEADERS='{"XAUTH_TRAVELPORT_ACCESSGROUP":"your-branch"}'
# GDS_TIMEOUT_MS="20000"

# Travelport Preprod normally requires your public IP to be whitelisted. With a
# correct endpoint and correct credentials an un-whitelisted connection still
# fails — you will see a transport error rather than a 401.
#
# A Travelport password that has been shared in a screenshot, a chat or a
# document should be rotated. Those emails say the password does not expire,
# which means it stays valid until somebody changes it deliberately.


# ---- Admin portal (optional) -----------------------------------------------
# Read on FIRST RUN ONLY, to seed content/users.json. After that the account
# exists and these are ignored; delete content/users.json to re-seed.
# ADMIN_EMAIL="you@softifybd.com"
# ADMIN_PASSWORD="pick-a-strong-one"
# ADMIN_PORT="4001"

# Where the main app runs, so admin's links point at the right place.
# APP_URL="http://localhost:3002"
