# MySQL — OTAPlatform's existing container.
# From Windows host (npm run dev): published port is 3307, root password is 'root'.
DATABASE_URL="mysql://root:root@127.0.0.1:3307/ota_market_intel"
# From inside a container on the shared network, use the service name + internal 3306:
# DATABASE_URL="mysql://root:root@otaplatform_mysql:3306/ota_market_intel"
NEXT_PUBLIC_APP_NAME="OTA Platform — Market Intelligence"
