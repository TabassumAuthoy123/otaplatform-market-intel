# Internal source documents — market pack, target-customer deck, Sabre PNR logs.
# Kept on disk, deliberately NOT pushed: this GitHub repo is public.
docs/

# Admin portal secrets and captured personal data — never commit these.
# users.json holds a password hash; leads.json holds names and phone numbers.
content/users.json
content/leads.json
content/.session-secret
content/*.tmp

# CRM working data. crm-activities.json accumulates call notes about named
# individuals — what someone said on the phone, why they said no. That is
# working data about real people and does not belong in a public repository.
# crm-leads.json IS committed: it is the compiled research from the public
# TOAB / BAIRA / ATAB / MoRA registers and is the shared raw-data file.
content/crm-activities.json

# TypeScript incremental build artefact
*.tsbuildinfo
