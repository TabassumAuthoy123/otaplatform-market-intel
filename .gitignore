node_modules
.next
out
.env
.env.local
*.log
.DS_Store

# Internal source documents — market pack, target-customer deck, Sabre PNR logs.
# Kept on disk, deliberately NOT pushed: this GitHub repo is public.
docs/

# Admin portal secrets and captured personal data — never commit these.
# users.json holds a password hash; leads.json holds names and phone numbers.
content/users.json
content/leads.json
content/.session-secret
content/*.tmp

# CRM working data. crm-activities.json accumulates call notes about named
# individuals — what someone said on the phone, why they said no. That is
# working data about real people and does not belong in a public repository.
# crm-leads.json IS committed: it is the compiled research from the public
# TOAB / BAIRA / ATAB / MoRA registers and is the shared raw-data file.
content/crm-activities.json

# TypeScript incremental build artefact
*.tsbuildinfo

# Storefront bookings — passenger names, passports and contact details.
content/bookings.json

# Audit log — who changed what, keyed by staff email address. Working data
# about named employees, and this repository is public.
content/audit-log.json
content/pre-restore-backup.json

# The pre-rotation copy of .env, written by scripts/rotate-gds-password.mjs.
# Holds the OLD supplier password until it is deleted — never commit it.
.env.before-rotation

# Scheduler output. alerts.json names invoices, customers and suppliers;
# scheduler-state.json and backups/ are operational and machine-specific.
content/alerts.json
content/scheduler-state.json
content/backups/

# CRM vocabulary overrides — runtime configuration a manager edits in the
# portal, per deployment, like the alerts file.
content/crm-vocab.json
